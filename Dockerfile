# Mini App interface: built here, served by the API from frontend/dist.
FROM node:22-slim AS frontend
WORKDIR /frontend
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim

# LibreOffice turns Word/PowerPoint sources into PDF (bot/sources.py); fonts with Cyrillic for it.
# Chromium renders and checks editable slides before the PPTX export (bot/editable/browser.py).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libreoffice-writer-nogui libreoffice-impress-nogui fonts-dejavu fonts-liberation fonts-crosextra-carlito \
        chromium \
    && rm -rf /var/lib/apt/lists/*

# Chromium's sandbox needs user namespaces that Docker does not give an unprivileged user.
# The browser only opens local HTML generated by the bot, with network lookups disabled.
RUN printf '#!/bin/sh\nexec /usr/bin/chromium --no-sandbox --disable-dev-shm-usage "$@"\n' > /usr/local/bin/chromium-headless \
    && chmod +x /usr/local/bin/chromium-headless

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    # LibreOffice and Chromium need a writable home; the container runs as an unprivileged user.
    HOME=/tmp \
    EDITABLE_CHROME_PATH=/usr/local/bin/chromium-headless

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY questions.yaml ./
COPY assets ./assets
COPY bot ./bot
COPY --from=frontend /frontend/dist ./frontend/dist

# prompts/, presets/, data/ and .env come from the host (docker-compose.yml).
# One image, three processes: bot (default), API and worker (commands in docker-compose.yml).
CMD ["/app/.venv/bin/python", "-m", "bot"]
