# Use your own development bot and API keys. Never commit .env.
BOT_TOKEN=123456:ABC-your-token-from-BotFather
DB_PATH=data/bot.db
FILES_DIR=data/sessions
QUESTIONS_PATH=questions.yaml
PROMPTS_DIR=prompts
PRESETS_DIR=presets

# Both keys are required by the current configuration loader.
GEMINI_API_KEY=your-gemini-api-key
VERTEX_API_KEY=your-vertex-api-key
# Uncomment if your Vertex configuration requires a project ID.
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Example model names used during development; choose models available to your project.
# An empty Gemini list routes text generation through Vertex.
GEMINI_TEXT_MODELS=
VERTEX_TEXT_MODELS=gemini-3.5-flash
IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3-pro-image

# Optional web search. Leave empty to disable.
TAVILY_API_KEY=
SEARCH_MAX_QUERIES=6

# Show both generation modes after style/background selection.
EDITABLE_PPTX_ENABLED=1
# EDITABLE_CHROME_PATH=/path/to/chrome
# Editable PPTX, slide layout and repairs: own Vertex models (empty = VERTEX_TEXT_MODELS),
# reasoning depth low|medium|high and how many slides are laid out in parallel.
EDITABLE_TEXT_MODELS=gemini-3.6-flash
EDITABLE_THINKING=medium
EDITABLE_PARALLEL=6
# Visual plan of the whole deck: own models and reasoning depth (empty = same as layout).
EDITABLE_PLAN_MODELS=gemini-3.1-pro-preview
EDITABLE_PLAN_THINKING=high
# Cheap vision model that reviews each rendered slide (empty = no review).
EDITABLE_REVIEW_MODELS=gemini-3.6-flash
EDITABLE_REVIEW_THINKING=medium
# Deck check "most slides are big text panels" (0 = off; it triggers most layout repairs).
EDITABLE_PANEL_CHECK=1
# LIBREOFFICE_PATH=/path/to/soffice

# Local Mini App pilot. Use scripts/run_miniapp.py for the first browser test.
# Standalone chat keeps its existing behavior unless PILOT_ENABLED=1.
PILOT_ENABLED=0
PILOT_ALLOWED_IDS=
PILOT_DAILY_LIMIT=3
PILOT_CONCURRENCY=3
# Standard (raster PDF) generation for new presentations; off = editable PPTX only, no mode question.
STANDARD_GENERATION_ENABLED=0
# The launcher generates a temporary session secret if none is configured.
# Set a stable random secret (32+ characters) for sessions across restarts.
WEB_SESSION_SECRET=
WEB_DEV_AUTH=0
WEB_INVITES_ENABLED=0
WEB_DEV_USER_ID=1
# HTTPS URL of the LOCAL test app; used only by the test bot's opening button.
MINIAPP_URL=

# Server only (docker-compose.yml): public domain of the Mini App for Caddy HTTPS.
# MINIAPP_URL is then https://<this domain>
SITE_ADDRESS=
