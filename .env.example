BOT_TOKEN=123456:ABC-your-token-from-BotFather
DB_PATH=data/bot.db
QUESTIONS_PATH=questions.yaml
GEMINI_API_KEY=AIza-your-key-from-aistudio
# Free text models, tried in order: each has its own daily free quota (about 20 requests).
# A model gets a few retries on overload, the next one is used at once when its daily quota is out.
GEMINI_TEXT_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-flash-latest,gemini-3.5-flash-lite
PROMPTS_DIR=prompts
# Optional: without it step 02 runs with no web search
TAVILY_API_KEY=tvly-your-key
SEARCH_MAX_QUERIES=6
# Images: Vertex AI key from the Google Cloud project (trial credits). Fast model first, Pro as fallback
VERTEX_API_KEY=AQ-your-vertex-key
IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3-pro-image
# Optional paid last resort for text, when every free model failed (Vertex AI, from the credits)
VERTEX_TEXT_MODELS=gemini-3.5-flash
# Uploaded and generated images, one folder per session
FILES_DIR=data/sessions
# LibreOffice converts Word/PowerPoint files to PDF so the model sees their pictures and charts.
# Found automatically (soffice on PATH or /Applications/LibreOffice.app); without it they are read as text.
# LIBREOFFICE_PATH=/usr/bin/soffice
